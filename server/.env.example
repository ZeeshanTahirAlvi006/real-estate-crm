# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS & Cookie Origin
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/proppulse_crm

# Redis Connection String (Optional - in-memory fallback enabled if offline)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production_32chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Configuration
COOKIE_SECRET=your_cookie_signing_secret_key_32chars_min
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Master Encryption Key (32-byte hex for AES-256-GCM)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef

# AI Provider Keys
OPEN_ROUTER_API=your_openrouter_api_key_here
GEMINI_API=your_gemini_api_key_here
MISTRAL_API=your_mistral_api_key_here

# Meta WhatsApp Business API Credentials
META_WHATSAPP_TOKEN=your_meta_whatsapp_token_here
META_PHONE_NUMBER_ID=your_meta_phone_number_id_here
META_VERIFY_TOKEN=your_meta_webhook_verify_token_here

# Rate Limits (req/min per role)
RATE_LIMIT_SUPER_ADMIN=recommended-300
RATE_LIMIT_BROKERAGE_OWNER=recommended-200
RATE_LIMIT_TEAM_LEAD=recommended-100
RATE_LIMIT_AGENT=recommended-90
RATE_LIMIT_LEAD=recommended-30
RATE_LIMIT_UNAUTHENTICATED=recommended-10

# Daily Quotas (Per-Person & Cumulative Brokerage)
QUOTA_DAILY_USER_REQUESTS=recommended-1000
QUOTA_DAILY_BROKERAGE_REQUESTS=recommended-20000
QUOTA_DAILY_USER_AI_TOKENS=recommended-50000
QUOTA_DAILY_BROKERAGE_AI_TOKENS=recommended-500000
QUOTA_DAILY_USER_SMS=recommended-100
QUOTA_DAILY_BROKERAGE_SMS=recommended-2000

# Circuit Breakers
CIRCUIT_BREAKER_FAILURE_THRESHOLD= recommended-5
CIRCUIT_BREAKER_COOLDOWN_MS=recommended-300000

