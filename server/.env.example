# Server Port & Environment
PORT=5000
NODE_ENV=development

# Frontend Client URL for CORS & Cookie Origin
CLIENT_URL=http://localhost:5173

# MongoDB Connection String
MONGODB_URI=mongodb://localhost:27017/proppulse_crm

# Redis Connection String (Optional - in-memory fallback enabled if offline)
REDIS_URL=redis://localhost:6379

# JWT Secrets (Minimum 32 characters)
JWT_ACCESS_SECRET=your_super_secret_access_token_key_change_in_production_32chars
JWT_REFRESH_SECRET=your_super_secret_refresh_token_key_change_in_production_32chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=30d

# Cookie Configuration
COOKIE_SECRET=your_cookie_signing_secret_key_32chars_min
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Master Encryption Key (32-byte hex for AES-256-GCM)
ENCRYPTION_MASTER_KEY=0123456789abcdef0123456789abcdef0123456789abcdef0123456789abcdef
