    "cors": "^2.8.5",
    "csv-parse": "^7.0.2",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "express-mongo-sanitize": "^2.2.0",
    "helmet": "^8.0.0",
    "imapflow": "^1.7.7",
    "ioredis": "^5.4.2",
    "jsonwebtoken": "^9.0.2",
    "mailparser": "^3.9.19",
    "mongoose": "^8.9.5",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "nodemailer": "^9.1.0",
    "pdfkit": "^0.20.2",
    "socket.io": "^4.8.3",
